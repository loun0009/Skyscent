{
  "expo": {
    "name": "SkyScent",
    "slug": "SkyScent",
    "scheme": "SkyScent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#6b4eff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "EXPO_PUBLIC_GOOGLE_PLACES_API_KEY"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptative_logo.png",
        "backgroundColor": "#6b4eff"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6b4eff",
          "sound": []
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "089671fb-e8fb-4e3b-85a7-2fb1f60e1778"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/089671fb-e8fb-4e3b-85a7-2fb1f60e1778"
    }
  }
}
